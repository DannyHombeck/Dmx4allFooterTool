<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Dmx4allFooterTool\Core\Content\Layout\LayoutDefinition">
            <tag name="shopware.entity.definition" entity="dmx4all_footer_tool_layout"/>
        </service>

        <service id="Dmx4allFooterTool\Service\LayoutService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="media.repository"/>
        </service>

        <service id="Dmx4allFooterTool\Twig\FooterToolExtension">
            <argument type="service" id="Dmx4allFooterTool\Service\LayoutService"/>
            <argument type="service" id="request_stack"/>
            <tag name="twig.extension"/>
        </service>
    </services>
</container>
